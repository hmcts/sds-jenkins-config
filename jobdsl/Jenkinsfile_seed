// lock is outside node so waiting jobs don't hold an executor
lock(resource: 'sds-seed-job') {
  node {
    checkout scm
    jobDsl scriptText: readFile('jobdsl/organisations.groovy'),
           additionalParameters: [ORG_GROUP: params.ORG_GROUP],
           removedJobAction: 'IGNORE',
           removedViewAction: 'IGNORE'
  }
}